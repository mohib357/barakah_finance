# ═══════════════════════════════════════════════════════════
#  BARAKAH FINANCE — Environment Variables Template
#
#  HOW TO USE:
#    Copy this file to .env.local for local development:
#      cp .env.example .env.local
#
#  ⚠️  NEVER commit .env.local to version control.
#  ⚠️  NEVER put real credentials in this file.
#      Use placeholder values only.
# ═══════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_RANDOM_32_BYTE_BASE64_STRING

# ── Database (PostgreSQL) ─────────────────────────────────
# Local:      postgresql://postgres:password@localhost:5432/barakah_finance?schema=public
# Railway:    postgresql://postgres:password@host.railway.app:port/railway?schema=public
# Supabase:   postgresql://postgres:password@db.project.supabase.co:5432/postgres?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/barakah_finance?schema=public"

# ── JWT (separate from NextAuth session) ─────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTE_BASE64_STRING
JWT_EXPIRES_IN=7d

# ── OTP & Two-Factor Auth ────────────────────────────────
# Name shown in Google Authenticator / Authy app
TOTP_ISSUER=BarakahFinance
# OTP TTL in seconds (600 = 10 minutes)
OTP_TTL_SECONDS=600

# ── SMS Gateway — BulkSMSBD (bulksmsbd.net) ──────────────
# Get your API key from: https://bulksmsbd.net/
SMS_API_KEY=your_bulksmsbd_api_key_here
SMS_API_URL=http://bulksmsbd.net/api/smsapi
SMS_BALANCE_URL=http://bulksmsbd.net/api/getBalanceApi
SMS_SENDER_ID=8809617611021

# ── File Upload ───────────────────────────────────────────
# Photo: max 2MB (2097152 bytes), Signature: max 100KB (102400 bytes)
MAX_PHOTO_SIZE_BYTES=2097152
MAX_SIGNATURE_SIZE_BYTES=102400
# Relative to project root — created automatically on first upload
UPLOAD_DIR=./public/uploads

# ── Database Backup ───────────────────────────────────────
BACKUP_INTERVAL_HOURS=1
BACKUP_RETENTION_DAYS=60
BACKUP_DIR=./backups

# ── Production Only (uncomment and set these for live server) ─
# NEXTAUTH_URL=https://barakahfinancebd.com
# ALLOWED_ORIGINS=https://barakahfinancebd.com
# FORCE_HTTPS=true
