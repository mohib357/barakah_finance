# ═══════════════════════════════════════════════════════════
#  BARAKAH FINANCE — Environment Variables
#  Copy this file to .env.local for local development.
#  NEVER commit .env.local to version control.
# ═══════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# ── Database (PostgreSQL) ─────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/barakah_finance?schema=public"

# ── JWT (used for API route tokens, separate from NextAuth) ──
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_EXPIRES_IN=7d

# ── OTP / 2FA ─────────────────────────────────────────────
# TOTP issuer name shown in authenticator app
TOTP_ISSUER=BarakahFinance
# OTP TTL in seconds (default 10 minutes)
OTP_TTL_SECONDS=600

# ── SMS Gateway (bulksmsbd.net) ───────────────────────────
SMS_API_KEY=your_bulksms_api_key
SMS_API_URL=http://bulksmsbd.net/api/smsapi
SMS_SENDER_ID=8809617611021

# ── File Upload ───────────────────────────────────────────
# Max file size in bytes (2 MB default for photos, 100 KB for signatures)
MAX_PHOTO_SIZE_BYTES=2097152
MAX_SIGNATURE_SIZE_BYTES=102400
# Where to store uploaded files on the server (relative to project root)
UPLOAD_DIR=./public/uploads

# ── Backup ────────────────────────────────────────────────
BACKUP_INTERVAL_HOURS=1
BACKUP_RETENTION_DAYS=60
BACKUP_DIR=./backups

# ── Production only ───────────────────────────────────────
# ALLOWED_ORIGINS=https://barakahfinancebd.com
# FORCE_HTTPS=true
